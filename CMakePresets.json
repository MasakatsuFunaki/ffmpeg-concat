{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 15,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conan-windows-release",
            "displayName": "Conan Windows Release (Visual Studio 17 2022)",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "${sourceDir}/build/generators/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
            }
        },
        {
            "name": "conan-linux-release",
            "displayName": "Conan Linux Release (Unix Makefiles)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/Release",
            "toolchainFile": "${sourceDir}/build/Release/generators/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "conan-windows-release",
            "configurePreset": "conan-windows-release",
            "configuration": "Release"
        },
        {
            "name": "conan-linux-release",
            "configurePreset": "conan-linux-release"
        }
    ],
    "testPresets": [
        {
            "name": "conan-windows-release",
            "configurePreset": "conan-windows-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "conan-linux-release",
            "configurePreset": "conan-linux-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
